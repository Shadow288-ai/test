  it('should be case insensitive', () => {
    const msftPrice = STOCK_PRICES['MSFT'];
    expect(getRealStockPrice('msft')).toBe(msftPrice);
    expect(getRealStockPrice('mSfT')).toBe(msftPrice);
  });

  it('should return null for unknown tickers', () => {
    expect(getRealStockPrice('UNKNOWN_TICKER_999')).toBeNull();
